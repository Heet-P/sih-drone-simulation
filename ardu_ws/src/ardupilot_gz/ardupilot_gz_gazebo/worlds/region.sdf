<?xml version="1.0" ?>
<!--
  GENERATED by worldgen/generate_region.py (casualty seed 3) -
  edit the generator, not this file. 200 x 200 m region: city (NE),
  forest (NW), village (SW), river + flood (SE); launch pad at the origin.
  Same frame, lights, sky and GPS origin as disaster.sdf.
-->
<sdf version="1.9">
  <world name="region">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-air-pressure-system"
      name="gz::sim::systems::AirPressure">
    </plugin>
    <plugin filename="gz-sim-air-speed-system"
      name="gz::sim::systems::AirSpeed">
    </plugin>
    <plugin filename="gz-sim-altimeter-system"
      name="gz::sim::systems::Altimeter">
    </plugin>
    <plugin filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>
    <plugin filename="gz-sim-magnetometer-system"
      name="gz::sim::systems::Magnetometer">
    </plugin>
    <plugin filename="gz-sim-navsat-system"
      name="gz::sim::systems::NavSat">
    </plugin>
    <plugin filename="gz-sim-particle-emitter-system"
      name="gz::sim::systems::ParticleEmitter">
    </plugin>

    <!-- Lighting identical to runway.sdf (see the notes there): low
         ambient + shadowless "fill" + "sun", so the command center's
         day/night switch applies the same values. Hazy grey-brown sky
         for the dust in the air. -->
    <scene>
      <ambient>0.15 0.15 0.15</ambient>
      <background>0.62 0.58 0.52</background>
    </scene>

    <light type="directional" name="fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Background temperature for the thermal camera (15 C). Objects
         with no thermal plugin render at this temperature, varied by how
         bright their texture is; Gazebo scales that spread with
         temperature_gradient. At the real-atmosphere -0.0065 K/m, white
         stones in the rubble read up to 347 K (hotter than a person) and
         dark ones hit the camera's 250 K floor, so the thermal model saw
         "people" all over the debris. -0.0003 gives a realistic
         ~285-289 K spread. -->
    <atmosphere type="adiabatic">
      <temperature>288</temperature>
      <temperature_gradient>-0.0003</temperature_gradient>
    </atmosphere>

    <!-- Must match SUN_DIRECTION_ENU in mavlink_bridge.py. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Sky: two emissive domes instead of <sky>, which can't change while
         the sim runs. The command center's night mode moves sky_day out of
         sight and sky_night to the origin (and back for day); the poses here
         and in server.py's NIGHT_POSES must match. -->
    <include>
      <name>sky_day</name>
      <uri>model://sky_dome</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <name>sky_night</name>
      <uri>model://sky_dome_night</uri>
      <pose>0 0 -100000 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <latitude_deg>-35.3632621</latitude_deg>
      <longitude_deg>149.1652374</longitude_deg>
      <elevation>10.0</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>

    
    <include><uri>model://region_scenery</uri></include>

    <!-- Hero models (Fuel, render-checked in Harmonic), all static -->
    <include><name>apartment</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Apartment</uri><pose>35.00 65.00 0 0 0 0.00</pose><static>true</static></include>
    <include><name>office_building</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Office Building</uri><pose>65.00 35.00 0 0 0 1.57</pose><static>true</static></include>
    <include><name>post_office</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Post office</uri><pose>65.00 65.00 0 0 0 0.00</pose><static>true</static></include>
    <include><name>indian_house_0</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/Indian House</uri><pose>-30.00 -25.00 0 0 0 0.30</pose><static>true</static></include>
    <include><name>indian_house_1</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/Indian House</uri><pose>-80.00 -25.00 0 0 0 -0.40</pose><static>true</static></include>
    <include><name>indian_house_2</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/Indian House</uri><pose>-40.00 -75.00 0 0 0 1.20</pose><static>true</static></include>
    <include><name>collapsed_house_village</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Collapsed House</uri><pose>-45.00 -52.00 0 0 0 0.60</pose><static>true</static></include>
    <include><name>truss_bridge</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Truss bridge</uri><pose>71.86 -60.00 0 0 0 0.00</pose><static>true</static></include>
    <include><name>bus_stranded</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bus</uri><pose>55.24 -80.00 0 0 0 1.30</pose><static>true</static></include>
    <include><name>house_river</name><uri>https://fuel.gazebosim.org/1.0/hisuki/models/House</uri><pose>30.00 -30.00 0 0 0 0.20</pose><static>true</static></include>
    <include><name>collapsed_house_river</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Collapsed House</uri><pose>28.00 -85.00 0 0 0 -0.40</pose><static>true</static></include>
    <include><name>car_0</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri><pose>25.00 1.50 0 0 0 0.00</pose><static>true</static></include>
    <include><name>car_1</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback blue</uri><pose>-40.00 -1.50 0 0 0 3.14</pose><static>true</static></include>
    <include><name>car_2</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Hatchback blue</uri><pose>1.50 60.00 0 0 0 1.57</pose><static>true</static></include>
    <include><name>car_3</name><uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Prius Hybrid</uri><pose>70.00 51.50 0 0 0 0.10</pose><static>true</static></include>

    <!-- Staging at the command post -->
    <include><name>ambulance</name><uri>model://ambulance</uri><pose>-12 -9 0 0 0 1.57</pose><static>true</static></include>
    <include><name>fire_truck</name><uri>model://fire_truck</uri><pose>-18 -9 0 0 0 1.57</pose><static>true</static></include>

    <!-- Fires (thermal hot spots; one with smoke) -->
    <model name="fire_city"><static>true</static><pose>50 92 0 0 0 0.3</pose>
      <link name="link">
        <visual name="ash"><geometry><mesh><uri>model://disaster_ground/meshes/rubble_mound_3.dae</uri><scale>2.0 1.8 0.8</scale></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.13 0.12 0.12 1</diffuse><specular>0 0 0 1</specular></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>305.0</temperature></plugin></visual>
        <visual name="beam_1"><pose>0 0 0.3 0 0.08 0</pose><geometry><box><size>2.6 0.3 0.3</size></box></geometry><material><ambient>0.03 0.025 0.02 1</ambient><diffuse>0.05 0.04 0.035 1</diffuse></material><plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>335.0</temperature></plugin></visual>
        <visual name="ember_1"><pose>0.3 0.1 0.35 0 0 0.4</pose><geometry><box><size>0.5 0.25 0.1</size></box></geometry><material><ambient>1 0.3 0.05 1</ambient><diffuse>1 0.3 0.05 1</diffuse><emissive>1 0.35 0.05 1</emissive></material><plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>365.0</temperature></plugin></visual>
      </link>
    </model>
    <include><name>smoke_fire_city</name><uri>model://smoke_plume</uri><pose>50 92 3 0 0 0</pose></include>
    <model name="fire_debris"><static>true</static><pose>28 45 0 0 0 0.3</pose>
      <link name="link">
        <visual name="ash"><geometry><mesh><uri>model://disaster_ground/meshes/rubble_mound_3.dae</uri><scale>2.0 1.8 0.8</scale></mesh></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.13 0.12 0.12 1</diffuse><specular>0 0 0 1</specular></material>
          <plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>305.0</temperature></plugin></visual>
        <visual name="beam_1"><pose>0 0 0.3 0 0.08 0</pose><geometry><box><size>2.6 0.3 0.3</size></box></geometry><material><ambient>0.03 0.025 0.02 1</ambient><diffuse>0.05 0.04 0.035 1</diffuse></material><plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>335.0</temperature></plugin></visual>
        <visual name="ember_1"><pose>0.3 0.1 0.35 0 0 0.4</pose><geometry><box><size>0.5 0.25 0.1</size></box></geometry><material><ambient>1 0.3 0.05 1</ambient><diffuse>1 0.3 0.05 1</diffuse><emissive>1 0.35 0.05 1</emissive></material><plugin filename="gz-sim-thermal-system" name="gz::sim::systems::Thermal"><temperature>365.0</temperature></plugin></visual>
      </link>
    </model>

