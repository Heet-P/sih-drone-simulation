<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- 300x300 m flat ground with a generated, tileable dust/cracked-soil
       texture (repeats every 20 m). Flat on purpose: the mission bridge
       projects detections onto the z=0 ground plane. -->
  <model name="disaster_ground">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry>
        <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry><mesh><uri>model://disaster_ground/meshes/ground.dae</uri></mesh></geometry>
      </visual>
    </link>
  </model>
</sdf>
