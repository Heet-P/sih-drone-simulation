-->
<model>
  <name>dog</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>Google</name><email>scanned-objects@google.com</email></author>
  <description>Sitting dog (~0.8 m long) with a fur-surface heat signature of 302-307 K, a non-human warm target for the thermal camera.</description>
</model>
