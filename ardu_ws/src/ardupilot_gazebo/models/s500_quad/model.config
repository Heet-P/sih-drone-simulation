<?xml version="1.0"?>
<model>
  <name>S500 Quad</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Heet Parikh</name>
  </author>
  <description>
    SIH Autonomous Hazard-Assistance Drone (24CS058).
    Derived from ArduPilot's iris_with_standoffs/iris_with_gimbal models.
    Real values used where measured: total mass 1.4 kg, 3S 11.1V 6200mAh
    battery. Motor thrust, LiftDrag coefficients, and inertia remain
    stock-Iris placeholders pending real thrust-test data (see project
    doc Section 9). Frame diagonal and prop size were already close
    enough to the real S500 + 8-inch-prop airframe to leave unchanged.
    Visual geometry reuses Iris meshes, no real S500 mesh available.
  </description>
</model>
